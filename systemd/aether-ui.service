[Unit]
Description=Aether Wayland interface
PartOf=graphical-session.target
After=graphical-session-pre.target aether.service
Wants=aether.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStartPre=-/usr/bin/qs -c aether kill
ExecStart=/usr/bin/qs -c aether
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=graphical-session.target
